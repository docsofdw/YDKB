        "prebuild:vercel": "npm config set ignore-scripts false",
        "postinstall": "npm install autoprefixer postcss tailwindcss date-fns typescript@5.7.3 --no-save"
    },
    "dependencies": {
        "@clerk/nextjs": "^6.12.0",
        "@radix-ui/react-aspect-ratio": "^1.1.2",
