{
    "name": "ydkb",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=18.19.0 <19.0.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf .next node_modules package-lock.json && npm install --no-ignore-scripts",
