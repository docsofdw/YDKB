        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@typescript-eslint/eslint-plugin": "^8.26.1",
        "@typescript-eslint/parser": "^8.26.1",
        "eslint": "^8.57.1",
        "eslint-config-next": "14.1.0",
        "typescript": "^5.7.3"
    }
