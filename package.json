        "@radix-ui/react-slot": "^1.1.2",
        "@supabase/ssr": "^0.1.0",
        "@supabase/supabase-js": "^2.39.3",
        "arg": "^5.0.2",
        "autoprefixer": "^10.4.20",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^2.30.0",
        "framer-motion": "^12.4.7",
        "geist": "^1.3.1",
        "lucide-react": "^0.477.0",
        "next": "14.1.0",
        "next-auth": "^4.24.11",
        "postcss": "^8.5.2",
        "react": "18.2.0",
        "react-dom": "18.2.0",
