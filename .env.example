# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login/[[...sign-in]]
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup/[[...sign-up]]
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional: Server-side Supabase service role key (for admin operations)
# CAUTION: Never expose this in client-side code or public repositories
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=YallDontKnowBall

NEXT_PUBLIC_BASE_URL=https://yourdomain.com

ADMIN_API_KEY=your_admin_api_key
CRON_SECRET=your_cron_secret_key

# TheSportsDB API Key (free tier)
THESPORTSDB_API_KEY=3 