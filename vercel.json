{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "bash vercel-prep.sh && npm run vercel-build",
  "installCommand": "npm config set ignore-scripts false && npm install",
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "env": {
    "NPM_CONFIG_IGNORE_SCRIPTS": "false",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  }
} 